# Copy to .env and set values as needed.

# --- Local full stack (docker-compose.litespeed.yml: db + litespeed) ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=wppass

# --- OrbitLab shared DB / app-only (docker-compose.litespeed-app-only.yml) ---
# Set these from POST /database response (host, port, database, user, password).
# MYSQL_HOST=mysql.example.orbitlab.dev
# MYSQL_PORT=3306
# MYSQL_DATABASE=db_xxxx
# MYSQL_USER=u_xxxx
# MYSQL_PASSWORD=...

# Optional
LSWS_VERSION=latest
PHP_VERSION=83
HTTP_PORT=8080
HTTPS_PORT=8443
