# Copy to .env and set values. Get MYSQL_* from OrbitLab POST /database or your MySQL.

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Required: WordPress salts — full block of define('AUTH_KEY',...); lines (from api.wordpress.org/secret-key/1.1/salt/ or wp-config.php)
# WP_SALTS=

# Optional
LSWS_VERSION=latest
PHP_VERSION=83
HTTP_PORT=8080
HTTPS_PORT=8443
